# Nuxt's standard local server. Never enable this variable in a production build.
NUXT_DEV_AUTH_BYPASS=false

# Supplied later, after an INPA-owned Cloudflare Access application exists.
NUXT_CF_ACCESS_TEAM_DOMAIN=
NUXT_CF_ACCESS_AUD=

# Optional public origin, supplied after a domain is approved.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
